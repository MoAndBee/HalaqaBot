{
  "name": "@halakabot/testing",
  "version": "1.0.0",
  "description": "Local test stack for the bot: Telegram simulator, fake Groq, in-memory Convex",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "bun run src/cli.ts",
    "test": "bun test --timeout 60000",
    "test:web": "bun test --timeout 120000 test/web-app.test.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@halakabot/db": "workspace:*",
    "convex": "1.27.0",
    "convex-test": "0.0.41",
    "grammy": "^1.38.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3",
    "playwright": "1.63.0",
    "wrangler": "^4.154.0"
  }
}
