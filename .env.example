# Web app (Vite reads this file; only VITE_ variables reach the browser).
# Bot configuration lives in packages/bot/.dev.vars locally (see
# packages/bot/.dev.vars.example) and in Worker secrets in production.

# Convex deployment URL. Also used by the scripts in packages/bot/scripts.
CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# The bot Worker's origin (no path), which the web app calls to act in Telegram.
# Local: http://localhost:8787 (bun run dev:bot)
VITE_BOT_API_URL=https://halaqabot.your-account.workers.dev

# The app only works signed in through Telegram: Convex accepts nothing else.
# To work on it locally, run it against the Telegram simulator (`bun run sim`,
# see packages/testing/README.md) and open it from the simulator's dashboard.
